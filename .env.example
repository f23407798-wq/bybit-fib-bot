# Copy this file's contents into Netlify → Site configuration → Environment
# variables (do NOT commit a real .env file — .gitignore already excludes it).

# Bybit API key/secret. Trade permission only — never enable Withdraw.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# true = testnet (fake money, safe to test with), false = real mainnet money.
# ALWAYS start with true.
BYBIT_TESTNET=true

# true = actually place orders on Bybit when a signal triggers.
# false = "dry run" — just logs what it WOULD have done. Start with false.
AUTO_TRADE=false

# Candle timeframe to scan — must match the cron schedule in netlify.toml.
SCAN_INTERVAL=15m

# How many top-turnover USDT perpetuals to scan each run. Keep this modest
# on Netlify's free plan (10s function timeout).
TOP_N=30

# How many symbols to fetch klines for at the same time.
SCAN_CONCURRENCY=5

# USDT size per trade (before leverage).
POSITION_SIZE_USDT=20

# Leverage to set on the symbol before opening a position.
LEVERAGE=3

# Safety cap: max number of brand-new trades a single scan run is allowed
# to place (protects you if many symbols trigger at once).
MAX_NEW_TRADES_PER_RUN=3

# Shared secret for the dashboard's "Scan Now" button (see scan-now.js).
# Pick any random string.
MANUAL_SCAN_TOKEN=
